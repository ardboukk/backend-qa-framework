  "item": [
    {
      "name": "Booking CRUD",
      "item": [
        {
          "name": "1. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test 1: status code\npm.test(\"Status is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Test 2: the response has a token\npm.test(\"Response contains a token\", function () {\n    const body = pm.response.json();\n    pm.expect(body.token).to.be.a(\"string\").and.not.empty;\n});\n\n// Save the token for later requests\nconst token = pm.response.json().token;\nif (token) {\n    pm.environment.set(\"token\", token);\n}\n\nif (!pm.response.json().token) {\n    console.log(\"Login failed, stopping the run:\", pm.response.text());\n    pm.execution.setNextRequest(null);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "   {\n     \"username\": \"admin\",\n     \"password\": \"password123\"\n   }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\nconst sent = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));\n\npm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));\n\npm.test(\"Response has a bookingid\", () => {\n    pm.expect(body).to.have.property(\"bookingid\");\n    pm.environment.set(\"bookingId\", body.bookingid);\n});\n\npm.test(\"Saved data matches what we sent\", () => {\n    pm.expect(body.booking.firstname).to.eql(sent.firstname);\n});\n\npm.collectionVariables.set(\"expectedFirstname\", sent.firstname);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique name for every run, so tests never clash\nconst firstname = \"QA-\" + Date.now();\npm.variables.set(\"firstname\", firstname);\n\n// Dates relative to today: check in tomorrow, check out 3 days later\nconst day = 24 * 60 * 60 * 1000;                       // one day in milliseconds\nconst checkin  = new Date(Date.now() + 1 * day).toISOString().slice(0, 10);\nconst checkout = new Date(Date.now() + 4 * day).toISOString().slice(0, 10);\npm.variables.set(\"checkin\", checkin);\npm.variables.set(\"checkout\", checkout);\n\nconsole.log(\"Creating booking for\", firstname, \"from\", checkin, \"to\", checkout);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disabledSystemHeaders": {}
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"QA\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Read booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test(\"Status is 200\", () => pm.response.to.have.status(200));\n\npm.test(\"Booking was really saved\", () => {\n    pm.expect(body.firstname).to.eql(pm.collectionVariables.get(\"expectedFirstname\"));\n});\n\nconst bookingSchema = {\n    type: \"object\",\n    required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],\n    properties: {\n        firstname:   { type: \"string\", minLength: 1 },\n        lastname:    { type: \"string\", minLength: 1 },\n        totalprice:  { type: \"number\", minimum: 0 },\n        depositpaid: { type: \"boolean\" },\n        bookingdates: {\n            type: \"object\",\n            required: [\"checkin\", \"checkout\"],\n            properties: {\n                checkin:  { type: \"string\" },\n                checkout: { type: \"string\" }\n            }\n        },\n        additionalneeds: { type: \"string\" }\n    },\n    additionalProperties: false\n};\n\npm.test(\"Response matches booking schema\", () => {\n    pm.response.to.have.jsonSchema(bookingSchema);\n});\n\npm.test(\"Lastname is QA\", () => {\n    pm.expect(body.lastname).to.eql(\"QA\");\n});\n\npm.test(\"Response time under 1 second\", () => {\n    pm.expect(pm.response.responseTime).to.be.below(1000);\n});\n\npm.test(\"No password in response\", () => {\n    pm.expect(body).to.not.have.property(\"password\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
